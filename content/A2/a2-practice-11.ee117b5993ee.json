{"module":"practice","item":{"id":"a2-practice-11","level":"A2","kind":"fill","title":{"de":"Perfekt, war, hatte","bn":"অতীত কাল: Perfekt, war, hatte"},"questions":[{"type":"gap","prompt":"Ich ___ gestern Fußball gespielt.","answers":["habe"],"options":["habe","bin","hatte"],"promptBn":"haben না sein?","id":"a2-practice-11-q1"},{"type":"gap","prompt":"Wir ___ nach Berlin gefahren.","answers":["sind"],"options":["sind","haben","waren"],"promptBn":"স্থান বদল → sein","id":"a2-practice-11-q2"},{"type":"gap","prompt":"Hast du die E-Mail ___? (lesen)","answers":["gelesen"],"options":["gelesen","gelest","liest"],"promptBn":"Partizip II","id":"a2-practice-11-q3"},{"type":"gap","prompt":"Gestern ___ ich krank. (ছিলাম)","answers":["war"],"options":["war","hatte","bin"],"promptBn":"sein-এর অতীত","id":"a2-practice-11-q4"},{"type":"gap","prompt":"Wir ___ keine Zeit. (ছিল না)","answers":["hatten"],"options":["hatten","waren","haben"],"promptBn":"haben-এর অতীত","id":"a2-practice-11-q5"},{"type":"gap","prompt":"Sie ist um sieben Uhr ___. (aufstehen)","answers":["aufgestanden"],"options":["aufgestanden","aufgesteht","aufstehen"],"promptBn":"Partizip II","id":"a2-practice-11-q6"},{"type":"gap","prompt":"Mein Bruder hat im Mai ___. (heiraten)","answers":["geheiratet"],"options":["geheiratet","heiratet","geheiraten"],"promptBn":"Partizip II","id":"a2-practice-11-q7"},{"type":"gap","prompt":"Der Arzt ___ mich gestern angerufen.","answers":["hat"],"options":["hat","ist","war"],"promptBn":"anrufen → haben","id":"a2-practice-11-q8"},{"type":"gap","prompt":"Wann ___ du nach Hause gekommen?","answers":["bist"],"options":["bist","hast","warst"],"promptBn":"kommen → sein","id":"a2-practice-11-q9"},{"type":"gap","prompt":"Ich habe das Formular ___. (unterschreiben)","answers":["unterschrieben"],"options":["unterschrieben","unterschreibt","geunterschrieben"],"promptBn":"Partizip II","id":"a2-practice-11-q10"},{"type":"gap","prompt":"Am Wochenende ___ das Wetter schön.","answers":["war"],"options":["war","hatte","wart"],"promptBn":"sein-এর অতীত","id":"a2-practice-11-q11"},{"type":"gap","prompt":"Ich habe heute noch ___ gegessen. (কিছুই না)","answers":["nichts"],"options":["nichts","etwas","niemand"],"promptBn":"কিছুই না","id":"a2-practice-11-q12"},{"type":"gap","prompt":"Meine Eltern wohnen ___ 2010 in Berlin. (থেকে)","answers":["seit"],"options":["seit","vor","bis"],"promptBn":"কখন থেকে","id":"a2-practice-11-q13"},{"type":"gap","prompt":"Er ist nicht Lehrer, ___ Arzt.","answers":["sondern"],"options":["sondern","aber","oder"],"promptBn":"nicht …, ___ …","id":"a2-practice-11-q14"},{"type":"gap","prompt":"___ Formular muss ich ausfüllen? (das Formular)","answers":["Welches"],"options":["Welches","Welcher","Welche"],"promptBn":"das → ?","id":"a2-practice-11-q15"},{"type":"gap","prompt":"Meine Schwester ist glücklich ___. (বিবাহিত)","answers":["verheiratet"],"options":["verheiratet","geschieden","ledig"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"a2-practice-11-q16"},{"type":"gap","prompt":"Bitte schicken Sie mir das Formular ___ E-Mail.","answers":["per"],"options":["per","mit","von"],"promptBn":"ই-মেইলের মাধ্যমে","id":"a2-practice-11-q17"},{"type":"gap","prompt":"Ich habe zwei ___. (das Kind, বহুবচন)","answers":["Kinder"],"options":["Kinder","Kinds","Kinde"],"promptBn":"A1 মনে করুন: বহুবচন","id":"a2-practice-11-q18"},{"type":"gap","prompt":"Gestern ___ ich krank und ___ nicht zur Arbeit gegangen.","answers":["war","bin"],"options":["war","bin","hatte","habe"],"promptBn":"প্রথমটি: অসুস্থ ছিলাম; দ্বিতীয়টি: gehen → sein","id":"a2-practice-11-q19"},{"type":"gap","prompt":"Mein Vater ___ zehn Jahre in Dhaka gearbeitet. Vor zwei Jahren ___ er nach Deutschland gekommen.","answers":["hat","ist"],"options":["hat","ist","war","hatte"],"promptBn":"arbeiten → haben, kommen → sein","id":"a2-practice-11-q20"}],"requires":{"grammar":5,"vocabulary":6}},"schema":1,"id":"a2-practice-11","level":"A2","test":[]}