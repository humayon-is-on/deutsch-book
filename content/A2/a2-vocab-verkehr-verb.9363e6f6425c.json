itum":"stellte ab","partizip":"abgestellt"}},{"id":"a2-w-verkehr-verb-sich-beeilen","de":"sich beeilen","bn":"তাড়াতাড়ি করা","forms":{"praeteritum":"beeilte sich","partizip":"sich beeilt"}},{"id":"a2-w-verkehr-verb-sich-ausruhen","de":"sich ausruhen","bn":"বিশ্রাম নেওয়া","forms":{"praeteritum":"ruhte sich aus","partizip":"sich ausgeruht"}},{"id":"a2-w-verkehr-verb-vorbeigehen","de":"vorbeigehen","bn":"পাশ দিয়ে যাওয়া","forms":{"praeteritum":"ging vorbei","partizip":"ist vorbeigegangen"}},{"id":"a2-w-verkehr-verb-vorbeikommen","de":"vorbeikommen","bn":"পাশ দিয়ে আসা, কিছুক্ষণ দেখা করা","forms":{"praeteritum":"kam vorbei","partizip":"ist vorbeigekommen"}}]},"schema":1,"id":"a2-vocab-verkehr-verb","level":"A2","test":[{"id":"test-a2-vocab-verkehr-verb-q1","type":"mcq","prompt":"„tanken“","promptBn":"এই শব্দের অর্থ কোনটি?","options":["সংরক্ষণ করা","টানা","তেল ভরা"],"answer":2},{"id":"test-a2-vocab-verkehr-verb-q2","type":"mcq","prompt":"„halten“","promptBn":"এই শব্দের অর্থ কোনটি?","options":["ধরা, থামানো","সংরক্ষণ করা","তেল ভরা"],"answer":0},{"id":"test-a2-vocab-verkehr-verb-q3","type":"mcq","prompt":"„vorbeikommen“","promptBn":"এই শব্দের অর্থ কোনটি?","options":["পরিবর্তন করা","মিস করা","পাশ দিয়ে আসা, কিছুক্ষণ দেখা করা"],"answer":2},{"id":"test-a2-vocab-verkehr-verb-q4","type":"mcq","prompt":"„benutzen“","promptBn":"এই শব্দের অর্থ কোনটি?","options":["ব্যবহার করা","খেয়াল রাখা","তাড়াতাড়ি করা"],"answer":0},{"id":"test-a2-vocab-verkehr-verb-q5","type":"mcq","prompt":"„sich beeilen“","promptBn":"এই শব্দের অর্থ কোনটি?","options":["ব্যবহার করা","সংরক্ষণ করা","তাড়াতাড়ি করা"],"answer":2},{"id":"test-a2-vocab-verkehr-verb-q6","type":"mcq","prompt":"„abstellen“","promptBn":"এই শব্দের অর্থ কোনটি?","options":["অর্থায়ন করা","সংরক্ষণ করা","বন্ধ করা, পার্ক করা"],"answer":2}]}