{"module":"practice","item":{"id":"a2-practice-13","level":"A2","kind":"fill","title":{"de":"Was hast du gemacht?","bn":"তুমি কী করেছ?"},"questions":[{"type":"gap","prompt":"Wir haben am Samstag einen Ausflug ___. (machen)","answers":["gemacht"],"options":["gemacht","macht","gemachen"],"promptBn":"Partizip II","id":"a2-practice-13-q1"},{"type":"gap","prompt":"Hast du den Film schon ___? (sehen)","answers":["gesehen"],"options":["gesehen","gesieht","sieht"],"promptBn":"Partizip II","id":"a2-practice-13-q2"},{"type":"gap","prompt":"Der Zug ist pünktlich ___. (ankommen)","answers":["angekommen"],"options":["angekommen","angekommt","ankommen"],"promptBn":"Partizip II: an + ge + kommen","id":"a2-practice-13-q3"},{"type":"gap","prompt":"Wir ___ gestern im Kino. (ছিলাম)","answers":["waren"],"options":["waren","hatten","sind"],"promptBn":"sein-এর অতীত","id":"a2-practice-13-q4"},{"type":"gap","prompt":"Er ___ im Urlaub viel Spaß. (haben-এর অতীত)","answers":["hatte"],"options":["hatte","war","hat"],"promptBn":"haben-এর অতীত","id":"a2-practice-13-q5"},{"type":"gap","prompt":"Ich habe meine Freundin ___. (anrufen)","answers":["angerufen"],"options":["angerufen","angerufet","anrufen"],"promptBn":"Partizip II","id":"a2-practice-13-q6"},{"type":"gap","prompt":"Wie lange ___ ihr in Berlin geblieben?","answers":["seid"],"options":["seid","habt","wart"],"promptBn":"bleiben → sein","id":"a2-practice-13-q7"},{"type":"gap","prompt":"Was hast du gestern ___? (essen)","answers":["gegessen"],"options":["gegessen","geesst","gegesst"],"promptBn":"Partizip II","id":"a2-practice-13-q8"},{"type":"gap","prompt":"Die Kinder ___ auf dem Spielplatz gespielt.","answers":["haben"],"options":["haben","sind","waren"],"promptBn":"spielen → haben","id":"a2-practice-13-q9"},{"type":"gap","prompt":"Wir ___ mit dem Zug nach München gefahren.","answers":["sind"],"options":["sind","haben","hatten"],"promptBn":"fahren → sein","id":"a2-practice-13-q10"},{"type":"gap","prompt":"Wann bist du nach Deutschland ___? (kommen)","answers":["gekommen"],"options":["gekommen","gekommt","kommt"],"promptBn":"Partizip II","id":"a2-practice-13-q11"},{"type":"gap","prompt":"___ Film hast du gesehen? (der Film)","answers":["Welchen"],"options":["Welchen","Welcher","Welches"],"promptBn":"Akkusativ: der → ?","id":"a2-practice-13-q12"},{"type":"gap","prompt":"Wir gehen nicht ins Kino, ___ in die Kneipe.","answers":["sondern"],"options":["sondern","aber","oder"],"promptBn":"nicht …, ___ …","id":"a2-practice-13-q13"},{"type":"gap","prompt":"Sara ist ___ drei Tagen nach Berlin gefahren. (আগে)","answers":["vor"],"options":["vor","seit","bis"],"promptBn":"আগে","id":"a2-practice-13-q14"},{"type":"gap","prompt":"Am Sonntag gehen wir auf den ___. (ফ্লি মার্কেট)","answers":["Flohmarkt"],"options":["Flohmarkt","Spielplatz","Fernseher"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"a2-practice-13-q15"},{"type":"gap","prompt":"Ich mache gern einen ___ im Park. (হেঁটে বেড়ানো)","answers":["Spaziergang"],"options":["Spaziergang","Fernseher","Fußball"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"a2-practice-13-q16"},{"type":"gap","prompt":"Bitte ___ Sie das Formular aus.","answers":["füllen"],"options":["füllen","schreiben","unterschreiben"],"promptBn":"ausfüllen","id":"a2-practice-13-q17"},{"type":"gap","prompt":"Ich trinke Kaffee ___ Milch. (সঙ্গে)","answers":["mit"],"options":["mit","von","für"],"promptBn":"A1 মনে করুন: সঙ্গে","id":"a2-practice-13-q18"},{"type":"gap","prompt":"Am Samstag ___ ich keine Zeit, aber am Sonntag ___ ich mit Sara ins Kino gegangen.","answers":["hatte","bin"],"options":["hatte","bin","war","habe"],"promptBn":"haben-এর অতীত; gehen → sein","id":"a2-practice-13-q19"},{"type":"gap","prompt":"Im Urlaub ___ wir nach Berlin gefahren, und am Abend ___ wir sehr müde.","answers":["sind","waren"],"options":["sind","waren","haben","hatten"],"promptBn":"fahren → sein; sein-এর অতীত","id":"a2-practice-13-q20"}],"requires":{"grammar":5,"vocabulary":7}},"schema":1,"id":"a2-practice-13","level":"A2","test":[]}