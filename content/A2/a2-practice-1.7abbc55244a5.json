{"module":"practice","item":{"id":"a2-practice-1","level":"A2","kind":"mcq","title":{"de":"man, jemand, niemand","bn":"man, jemand, niemand"},"questions":[{"type":"mcq","prompt":"„In Deutschland trinkt man viel Tee.“ এখানে man মানে কী?","options":["একজন পুরুষ","আমার স্বামী","সাধারণভাবে মানুষ"],"answer":2,"explanation":"man কোনো নির্দিষ্ট মানুষ নয়।","id":"a2-practice-1-q1"},{"type":"mcq","prompt":"„কেউ না“ জার্মানে কোনটি?","options":["niemand","jemand","nichts"],"answer":0,"id":"a2-practice-1-q2"},{"type":"mcq","prompt":"„কিছু একটা“ জার্মানে কোনটি?","options":["niemand","etwas","nichts"],"answer":1,"id":"a2-practice-1-q3"},{"type":"mcq","prompt":"Hier ___ man nicht parken.","options":["dürfen","darfst","darf"],"answer":2,"explanation":"man-এর সঙ্গে er/sie/es-এর রূপ: man darf।","id":"a2-practice-1-q4"},{"type":"mcq","prompt":"„Ist jemand im Büro?“ মানে কী?","options":["অফিসে কি কেউ আছে?","অফিসে কেউ নেই।","অফিসে সবাই আছে।"],"answer":0,"id":"a2-practice-1-q5"},{"type":"mcq","prompt":"„Ich esse heute nichts.“ মানে কী?","options":["আমি আজ সব খাই।","আমি আজ কিছুই খাই না।","আমি আজ কিছু খাই।"],"answer":1,"id":"a2-practice-1-q6"},{"type":"mcq","prompt":"Möchtest du ___ essen? (কিছু)","options":["nichts","niemand","etwas"],"answer":2,"id":"a2-practice-1-q7"},{"type":"mcq","prompt":"„Niemand wohnt hier.“ মানে কী?","options":["এখানে কেউ থাকে না।","এখানে কেউ একজন থাকে।","এখানে সবাই থাকে।"],"answer":0,"id":"a2-practice-1-q8"},{"type":"mcq","prompt":"Im Restaurant ___ man die Rechnung. (bezahlen)","options":["bezahlst","bezahlt","bezahlen"],"answer":1,"explanation":"man → er-এর রূপ: bezahlt।","id":"a2-practice-1-q9"},{"type":"mcq","prompt":"„Hat jemand einen Kugelschreiber?“ মানে কী?","options":["কারো কাছে কলম নেই।","আমার একটি কলম আছে।","কারো কাছে কি একটি কলম আছে?"],"answer":2,"id":"a2-practice-1-q10"},{"type":"mcq","prompt":"„Ich verstehe nichts.“ মানে কী?","options":["আমি কিছুই বুঝি না।","আমি সব বুঝি।","আমি কিছু একটা বুঝি।"],"answer":0,"id":"a2-practice-1-q11"},{"type":"mcq","prompt":"„jemand“-এর বিপরীত কোনটি?","options":["man","niemand","etwas"],"answer":1,"id":"a2-practice-1-q12"},{"type":"mcq","prompt":"„etwas“-এর বিপরীত কোনটি?","options":["jemand","niemand","nichts"],"answer":2,"id":"a2-practice-1-q13"},{"type":"mcq","prompt":"কোন বাক্যটি সঠিক?","options":["Hier spricht man Deutsch.","Hier sprechen man Deutsch.","Hier sprichst man Deutsch."],"answer":0,"explanation":"man → spricht।","id":"a2-practice-1-q14"},{"type":"mcq","prompt":"Ich habe ___ Zeit.","options":["kein","keine","nicht"],"answer":1,"explanation":"A1 মনে করুন: die Zeit → keine।","id":"a2-practice-1-q15"}],"requires":{"grammar":1,"vocabulary":0}},"schema":1,"id":"a2-practice-1","level":"A2","test":[]}