{"module":"practice","item":{"id":"a2-practice-28","level":"A2","kind":"mcq","title":{"de":"Reflexive Verben","bn":"Reflexive Verb"},"questions":[{"type":"mcq","prompt":"Ich freue ___ auf den Ausflug.","options":["mich","dich","sich"],"answer":0,"explanation":"ich → mich।","id":"a2-practice-28-q1"},{"type":"mcq","prompt":"Er meldet ___ für den Tanzkurs an.","options":["uns","sich","mich"],"answer":1,"explanation":"er → sich।","id":"a2-practice-28-q2"},{"type":"mcq","prompt":"Wir freuen ___ auf die Party.","options":["sich","euch","uns"],"answer":2,"explanation":"wir → uns।","id":"a2-practice-28-q3"},{"type":"mcq","prompt":"Freust du ___ auf den Urlaub?","options":["dich","mich","sich"],"answer":0,"explanation":"du → dich।","id":"a2-practice-28-q4"},{"type":"mcq","prompt":"„Ich melde mich für den Kurs an.“ মানে কী?","options":["আমি কোর্স ছেড়ে দিই।","আমি কোর্সে নাম লেখাই।","আমি কোর্স শেষ করি।"],"answer":1,"id":"a2-practice-28-q5"},{"type":"mcq","prompt":"ihr-এর reflexive pronoun কোনটি?","options":["uns","sich","euch"],"answer":2,"id":"a2-practice-28-q6"},{"type":"mcq","prompt":"„Sie ruht sich aus.“ মানে কী?","options":["সে বিশ্রাম নিচ্ছে।","সে আহত হয়েছে।","সে তাড়াতাড়ি করছে।"],"answer":0,"id":"a2-practice-28-q7"},{"type":"mcq","prompt":"Du musst ___ beeilen.","options":["sich","dich","mich"],"answer":1,"explanation":"du → dich।","id":"a2-practice-28-q8"},{"type":"mcq","prompt":"„verpassen“ মানে কী?","options":["তেল ভরা","ব্রেক করা","মিস করা"],"answer":2,"id":"a2-practice-28-q9"},{"type":"mcq","prompt":"„tanken“ মানে কী?","options":["থামানো","তেল ভরা","পার্ক করা"],"answer":1,"id":"a2-practice-28-q10"},{"type":"mcq","prompt":"„Der Zug hat Verspätung.“ মানে কী?","options":["ট্রেনটি সময়মতো।","ট্রেনটি বাতিল।","ট্রেনটি দেরিতে আসছে।"],"answer":2,"id":"a2-practice-28-q11"},{"type":"mcq","prompt":"„das Gleis“ মানে কী?","options":["রেললাইন","জাহাজ","পার্কিং গ্যারেজ"],"answer":0,"id":"a2-practice-28-q12"},{"type":"mcq","prompt":"Ich gebe ___ Frau die Fahrkarte.","options":["den","der","die"],"answer":1,"explanation":"কাকে → Dativ: der Frau।","id":"a2-practice-28-q13"},{"type":"mcq","prompt":"„der Strafzettel“ মানে কী?","options":["ড্রাইভিং লাইসেন্স","টিকিট","জরিমানা নোটিশ"],"answer":2,"id":"a2-practice-28-q14"},{"type":"mcq","prompt":"„Komm bitte!“ কাকে বলা হচ্ছে?","options":["তুমি (du)","তোমরা (ihr)","আপনি (Sie)"],"answer":0,"explanation":"A1 মনে করুন: Imperativ।","id":"a2-practice-28-q15"}],"requires":{"grammar":8,"vocabulary":23}},"schema":1,"id":"a2-practice-28","level":"A2","test":[]}