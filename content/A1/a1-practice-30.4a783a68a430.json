{"module":"practice","item":{"id":"a1-practice-30","level":"A1","kind":"mcq","title":{"de":"Präpositionen","bn":"অব্যয় (Präpositionen)"},"questions":[{"type":"mcq","prompt":"Ich wohne ___ Berlin.","options":["in","nach","zu"],"answer":0,"explanation":"শহরের ভেতরে থাকা → in","id":"a1-practice-30-q1"},{"type":"mcq","prompt":"Ich fahre morgen ___ Köln.","options":["in","nach","bei"],"answer":1,"explanation":"শহর বা দেশে যাওয়া → nach","id":"a1-practice-30-q2"},{"type":"mcq","prompt":"Er kommt ___ Bangladesch.","options":["aus","von","nach"],"answer":0,"explanation":"দেশ থেকে আসা → aus","id":"a1-practice-30-q3"},{"type":"mcq","prompt":"Wir gehen ___ Arzt.","options":["zum","nach","im"],"answer":0,"explanation":"মানুষের কাছে যাওয়া → zu (zum)","id":"a1-practice-30-q4"},{"type":"mcq","prompt":"Der Kurs beginnt ___ neun Uhr.","options":["am","um","im"],"answer":1,"explanation":"ঘড়ির সময় → um","id":"a1-practice-30-q5"},{"type":"mcq","prompt":"Ich habe ___ Montag frei.","options":["am","um","im"],"answer":0,"explanation":"দিনের নাম → am","id":"a1-practice-30-q6"},{"type":"mcq","prompt":"Mein Geburtstag ist ___ Mai.","options":["am","um","im"],"answer":2,"explanation":"মাসের নাম → im","id":"a1-practice-30-q7"},{"type":"mcq","prompt":"Ich fahre ___ dem Bus.","options":["mit","von","bei"],"answer":0,"explanation":"যানবাহন → mit","id":"a1-practice-30-q8"},{"type":"mcq","prompt":"Das Geschenk ist ___ dich.","options":["für","mit","zu"],"answer":0,"explanation":"কারো জন্য → für","id":"a1-practice-30-q9"},{"type":"mcq","prompt":"Sie wohnt ___ ihren Eltern.","options":["bei","zu","nach"],"answer":0,"explanation":"কারো বাসায় থাকা → bei","id":"a1-practice-30-q10"},{"type":"mcq","prompt":"Auf ___ Schreibtisch steht mein Computer.","options":["den","dem","der"],"answer":1,"explanation":"auf (কোথায়?) + Dativ: der → dem","id":"a1-practice-30-q11"},{"type":"mcq","prompt":"Ich fahre ___ dem Bus zur Arbeit.","options":["mit","bei","für"],"answer":0,"explanation":"যানবাহন → mit","id":"a1-practice-30-q12"},{"type":"mcq","prompt":"Wir treffen uns ___ Park.","options":["am","um","im"],"answer":2,"explanation":"in + dem → im","id":"a1-practice-30-q13"},{"type":"mcq","prompt":"Ich lerne ___ zwei Uhr.","options":["seit","bis","für"],"answer":1,"explanation":"পর্যন্ত → bis","id":"a1-practice-30-q14"},{"type":"mcq","prompt":"Am Abend gehe ich ___ Bett.","options":["ins","im","zum"],"answer":0,"explanation":"in + das → ins","id":"a1-practice-30-q15"}]},"schema":1,"id":"a1-practice-30","level":"A1","test":[]}