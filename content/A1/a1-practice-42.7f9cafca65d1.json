{"module":"practice","item":{"id":"a1-practice-42","level":"A1","kind":"fill","title":{"de":"Wochenende und Freizeit","bn":"সপ্তাহান্ত ও অবসর"},"questions":[{"type":"gap","prompt":"Am Samstag ___ ich früh ___. (aufstehen)","answers":["stehe","auf"],"options":["stehe","auf","steht","an"],"promptBn":"aufstehen → stehe … auf","id":"a1-practice-42-q1"},{"type":"gap","prompt":"Am Sonntag ___ wir unsere Oma, ___ sie ist krank.","answers":["besuchen","denn"],"options":["besuchen","denn","besucht","aber"],"promptBn":"besuchen (wir), তারপর কারণ → denn","id":"a1-practice-42-q2"},{"type":"gap","prompt":"Ich ___ gern Musik und ___ oft ins Kino.","answers":["höre","gehe"],"options":["höre","gehe","hört","geht"],"promptBn":"ich → -e","id":"a1-practice-42-q3"},{"type":"gap","prompt":"___ du am Wochenende Zeit? – Ja, ich ___ Zeit.","answers":["Hast","habe"],"options":["Hast","habe","Hat","hat"],"promptBn":"du → hast, ich → habe","id":"a1-practice-42-q4"},{"type":"gap","prompt":"Wir ___ am Samstag Fußball, aber am Sonntag ___ wir.","answers":["spielen","schlafen"],"options":["spielen","schlafen","spielt","schläft"],"promptBn":"wir → -en","id":"a1-practice-42-q5"},{"type":"gap","prompt":"Am Abend ___ ich ein Buch, und meine Schwester ___ fern.","answers":["lese","sieht"],"options":["lese","sieht","liest","sehe"],"promptBn":"lesen: ich lese; fernsehen: sie sieht … fern","id":"a1-practice-42-q6"},{"type":"gap","prompt":"Möchtest du ins Kino ___ in den Park? – Ins Kino, ___ es regnet.","answers":["oder","denn"],"options":["oder","denn","und","aber"],"promptBn":"বেছে নেওয়া → oder, কারণ → denn","id":"a1-practice-42-q7"},{"type":"gap","prompt":"Ich ___ am Samstag nicht arbeiten, ich ___ frei.","answers":["muss","habe"],"options":["muss","habe","kann","bin"],"promptBn":"müssen: ich muss; haben: ich habe","id":"a1-practice-42-q8"},{"type":"gap","prompt":"Am Sonntag ___ meine Freunde zu mir und wir ___ zusammen.","answers":["kommen","kochen"],"options":["kommen","kochen","kommt","kocht"],"promptBn":"meine Freunde (বহুবচন) → -en, wir → -en","id":"a1-practice-42-q9"},{"type":"gap","prompt":"Am Wochenende ___ ich mein Zimmer auf.","answers":["räume"],"options":["räume","räumst","räumt"],"promptBn":"aufräumen → räume … auf","id":"a1-practice-42-q10"},{"type":"gap","prompt":"Wir fahren am Samstag ___ Berlin.","answers":["nach"],"options":["nach","um","zu"],"promptBn":"শহরের নামের আগে → nach","id":"a1-practice-42-q11"},{"type":"gap","prompt":"Am Sonntag gehen wir in ___ Park.","answers":["den"],"options":["den","das","dem"],"promptBn":"in + Akkusativ (কোথায় যাওয়া): der Park → den","id":"a1-practice-42-q12"},{"type":"gap","prompt":"Ich treffe ___ Freunde im Kaffeehaus.","answers":["meine"],"options":["meine","mein","meinen"],"promptBn":"die Freunde (বহুবচন) → meine","id":"a1-practice-42-q13"},{"type":"gap","prompt":"Kommst du ___? – Nein, ich ___ leider keine Zeit.","answers":["mit","habe"],"options":["mit","habe","an","hat"],"promptBn":"mitkommen → kommst … mit; ich → habe","id":"a1-practice-42-q14"},{"type":"gap","prompt":"Am Samstag ___ ich Geburtstag und ___ mit meinen Freunden.","answers":["habe","feiere"],"options":["habe","feiere","hat","feiert"],"promptBn":"ich → habe, ich → feiere","id":"a1-practice-42-q15"}]},"schema":1,"id":"a1-practice-42","level":"A1","test":[]}