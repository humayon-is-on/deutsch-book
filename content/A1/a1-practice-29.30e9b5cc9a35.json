{"module":"practice","item":{"id":"a1-practice-29","level":"A1","kind":"fill","title":{"de":"Trennbare Verben","bn":"আলাদা হয় এমন ক্রিয়া"},"questions":[{"type":"gap","prompt":"Ich stehe um sechs Uhr ___. (aufstehen)","answers":["auf"],"options":["auf","am","um"],"promptBn":"aufstehen → ich stehe … auf","id":"a1-practice-29-q1"},{"type":"gap","prompt":"Der Zug ___ um acht Uhr an. (ankommen)","answers":["kommt"],"options":["kommt","komme","kommst"],"promptBn":"ankommen → der Zug kommt … an","id":"a1-practice-29-q2"},{"type":"gap","prompt":"Wir kaufen im Supermarkt ___. (einkaufen)","answers":["ein"],"options":["ein","eine","einen"],"promptBn":"einkaufen → wir kaufen … ein","id":"a1-practice-29-q3"},{"type":"gap","prompt":"Rufst du mich morgen ___? (anrufen)","answers":["an"],"options":["an","ins","am"],"promptBn":"anrufen → rufst du … an","id":"a1-practice-29-q4"},{"type":"gap","prompt":"Sie ___ das Fenster auf. (aufmachen)","answers":["macht"],"options":["macht","mache","machst"],"promptBn":"aufmachen → sie macht … auf","id":"a1-practice-29-q5"},{"type":"gap","prompt":"Ich sehe am Abend ___. (fernsehen)","answers":["fern"],"options":["fern","mit","zu"],"promptBn":"fernsehen → ich sehe … fern","id":"a1-practice-29-q6"},{"type":"gap","prompt":"Wann ___ der Bus ab? (abfahren)","answers":["fährt"],"options":["fährt","fährst","fahren"],"promptBn":"abfahren → der Bus fährt … ab","id":"a1-practice-29-q7"},{"type":"gap","prompt":"Bitte steigen Sie hier ___. (aussteigen)","answers":["aus"],"options":["aus","mit","von"],"promptBn":"aussteigen → steigen Sie … aus","id":"a1-practice-29-q8"},{"type":"gap","prompt":"Ich ___ meine Freundin vom Bahnhof ab. (abholen)","answers":["hole"],"options":["hole","holst","holt"],"promptBn":"abholen → ich hole … ab","id":"a1-practice-29-q9"},{"type":"gap","prompt":"Er räumt die Küche ___. (aufräumen)","answers":["auf"],"options":["auf","am","um"],"promptBn":"aufräumen → er räumt … auf","id":"a1-practice-29-q10"},{"type":"gap","prompt":"Ich ___ jeden Morgen um sieben Uhr auf. (aufstehen)","answers":["stehe"],"options":["stehe","stehst","steht"],"promptBn":"aufstehen → ich stehe … auf","id":"a1-practice-29-q11"},{"type":"gap","prompt":"Am Wochenende probiere ich neue Rezepte ___.","answers":["aus"],"options":["aus","mit","von"],"promptBn":"probieren … aus: উপসর্গ বাক্যের শেষে","id":"a1-practice-29-q12"},{"type":"gap","prompt":"Der Bus fährt um neun Uhr ___. (abfahren)","answers":["ab"],"options":["ab","an","aus"],"promptBn":"abfahren → fährt … ab","id":"a1-practice-29-q13"},{"type":"gap","prompt":"Wann ___ der Zug an? (ankommen)","answers":["kommt"],"options":["kommt","komme","kommst"],"promptBn":"ankommen → kommt … an","id":"a1-practice-29-q14"},{"type":"gap","prompt":"Ich ___ meine Mutter jeden Sonntag ___. (anrufen)","answers":["rufe","an"],"options":["rufe","an","rufst","ins"],"promptBn":"দুটি ঘরই পূরণ করুন","explanation":"anrufen → ich rufe … an","id":"a1-practice-29-q15"}]},"schema":1,"id":"a1-practice-29","level":"A1","test":[]}