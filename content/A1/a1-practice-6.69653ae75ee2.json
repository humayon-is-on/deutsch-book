{"module":"practice","item":{"id":"a1-practice-6","level":"A1","kind":"mcq","title":{"de":"Wortschatz: Familie und Freunde","bn":"শব্দভান্ডার: পরিবার ও বন্ধু"},"questions":[{"type":"mcq","prompt":"Die Mutter von meiner Mutter ist meine ___.","options":["Tante","Oma","Schwester"],"answer":1,"id":"a1-practice-6-q1"},{"type":"mcq","prompt":"Der Bruder von meinem Vater ist mein ___.","options":["Onkel","Opa","Sohn"],"answer":0,"id":"a1-practice-6-q2"},{"type":"mcq","prompt":"Mein Vater und meine Mutter sind meine ___.","options":["Kinder","Geschwister","Eltern"],"answer":2,"id":"a1-practice-6-q3"},{"type":"mcq","prompt":"Ein Mädchen ist ein junges ___.","options":["Kind","Mann","Herr"],"answer":0,"explanation":"das Mädchen = মেয়ে শিশু","id":"a1-practice-6-q4"},{"type":"mcq","prompt":"Der Sohn von meiner Tochter ist mein ___.","options":["Enkelkind","Bruder","Onkel"],"answer":0,"id":"a1-practice-6-q5"},{"type":"mcq","prompt":"Die Frau von meinem Bruder ist seine ___.","options":["Tochter","Ehefrau","Oma"],"answer":1,"id":"a1-practice-6-q6"},{"type":"mcq","prompt":"Er wohnt neben mir. Er ist mein ___.","options":["Nachbar","Vater","Lehrer"],"answer":0,"id":"a1-practice-6-q7"},{"type":"mcq","prompt":"Mein Bruder und meine Schwester sind meine ___.","options":["Eltern","Geschwister","Freunde"],"answer":1,"id":"a1-practice-6-q8"},{"type":"mcq","prompt":"„der Sohn“ – বিপরীত শব্দ কোনটি?","options":["die Tochter","die Mutter","die Tante"],"answer":0,"id":"a1-practice-6-q9"},{"type":"mcq","prompt":"„der Junge“ – বিপরীত শব্দ কোনটি?","options":["das Kind","das Mädchen","die Oma"],"answer":1,"id":"a1-practice-6-q10"},{"type":"mcq","prompt":"Ein sehr kleines Kind ist ein ___.","options":["Baby","Herr","Freund"],"answer":0,"id":"a1-practice-6-q11"},{"type":"mcq","prompt":"„Guten Tag, meine ___ und Herren!“","options":["Damen","Frauen","Mütter"],"answer":0,"id":"a1-practice-6-q12"},{"type":"mcq","prompt":"Die Schwester von meiner Mutter ist meine ___.","options":["Oma","Tochter","Tante"],"answer":2,"id":"a1-practice-6-q13"},{"type":"mcq","prompt":"Sara ist nicht meine Schwester, sie ist meine ___.","options":["Onkel","Freundin","Vater"],"answer":1,"id":"a1-practice-6-q14"},{"type":"mcq","prompt":"Der Vater von meinem Vater ist mein ___.","options":["Onkel","Bruder","Opa"],"answer":2,"id":"a1-practice-6-q15"}]},"schema":1,"id":"a1-practice-6","level":"A1","test":[]}