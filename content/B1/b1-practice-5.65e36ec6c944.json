{"module":"practice","item":{"id":"b1-practice-5","level":"B1","kind":"fill","title":{"de":"Rund ums Wohnen 3","bn":"বাসস্থান ৩"},"questions":[{"type":"gap","prompt":"Am Samstag ___ ich die Wohnung. (পরিষ্কার করা)","answers":["putze"],"options":["putze","putzt","putzen"],"promptBn":"ich → -e","id":"b1-practice-5-q1"},{"type":"gap","prompt":"Wir ___ nächsten Monat nach Köln um. (স্থানান্তর করা)","answers":["ziehen"],"options":["ziehen","zieht","ziehe"],"promptBn":"umziehen: wir → ziehen … um","id":"b1-practice-5-q2"},{"type":"gap","prompt":"Bitte ___ Sie das Licht ein. (চালু করা)","answers":["schalten"],"options":["schalten","schaltet","schalte"],"promptBn":"einschalten: Sie → schalten … ein","id":"b1-practice-5-q3"},{"type":"gap","prompt":"Ich ___ mein Zimmer neu ein. (সজ্জিত করা)","answers":["richte"],"options":["richte","richtet","richten"],"promptBn":"einrichten: ich → richte … ein","id":"b1-practice-5-q4"},{"type":"gap","prompt":"Er möchte die Wohnung ___. (বাতিল করা)","answers":["kündigen"],"options":["kündigen","kündigt","kündige"],"promptBn":"möchte + infinitive","id":"b1-practice-5-q5"},{"type":"gap","prompt":"In dieser Wohnung kann ich mich ___. (ভালো বোধ করা)","answers":["wohlfühlen"],"options":["wohlfühlen","einschalten","dekorieren"],"promptBn":"sich wohlfühlen","id":"b1-practice-5-q6"},{"type":"gap","prompt":"Wir ___ den Tisch für das Essen. (ঢাকা দেওয়া, সাজানো)","answers":["decken"],"options":["decken","dekorieren","putzen"],"promptBn":"den Tisch decken","id":"b1-practice-5-q7"},{"type":"gap","prompt":"Bitte ___ Sie die Tür. (তালা লাগানো)","answers":["verschließen"],"options":["verschließen","einschalten","gestalten"],"promptBn":"Sie → infinitive-এর রূপ","id":"b1-practice-5-q8"},{"type":"gap","prompt":"Bevor ich ___, putze ich die Küche. (umziehen)","answers":["umziehe"],"options":["umziehe","ziehe um","umziehen"],"promptBn":"bevor-এর অংশে verb শেষে, একসঙ্গে লেখা","id":"b1-practice-5-q9"},{"type":"gap","prompt":"___ ich schlafe, lese ich ein Buch. (আগে)","answers":["Bevor"],"options":["Bevor","Während","Obwohl"],"promptBn":"আগে","id":"b1-practice-5-q10"},{"type":"gap","prompt":"Während ich ___, hört meine Frau Musik. (putzen)","answers":["putze"],"options":["putze","putzt","putzen"],"promptBn":"während-এর অংশে verb শেষে","id":"b1-practice-5-q11"},{"type":"gap","prompt":"Obwohl wir wenig Geld ___, ziehen wir um.","answers":["haben"],"options":["haben","hat","habe"],"promptBn":"obwohl-এর অংশে verb শেষে","id":"b1-practice-5-q12"},{"type":"gap","prompt":"Das Auto steht in der ___. (আন্ডারগ্রাউন্ড গ্যারেজ)","answers":["Tiefgarage"],"options":["Tiefgarage","Steckdose","Badewanne"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-5-q13"},{"type":"gap","prompt":"Wir haben einen Hund als ___. (পোষা প্রাণী)","answers":["Haustier"],"options":["Haustier","Fahrzeug","Hochhaus"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-5-q14"},{"type":"gap","prompt":"Ich habe meine Schlüssel ___. (verlieren, Perfekt)","answers":["verloren"],"options":["verloren","verliert","verlieren"],"promptBn":"A2: verlieren → verloren","id":"b1-practice-5-q15"}],"requires":{"grammar":3,"vocabulary":3}},"schema":1,"id":"b1-practice-5","level":"B1","test":[]}