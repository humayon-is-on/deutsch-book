{"module":"practice","item":{"id":"b1-practice-39","level":"B1","kind":"mcq","title":{"de":"Gesund bleiben 6","bn":"সুস্থ থাকা ৬"},"questions":[{"type":"mcq","prompt":"„erkältet“ মানে কী?","options":["জেগে থাকা","ফ্যাকাশে","ঠান্ডা লেগেছে এমন"],"answer":2,"id":"b1-practice-39-q1"},{"type":"mcq","prompt":"„ansteckend“ মানে কী?","options":["সংক্রামক","প্রেসক্রিপশন ছাড়া","প্রদাহযুক্ত"],"answer":0,"id":"b1-practice-39-q2"},{"type":"mcq","prompt":"Diese Tabletten sind ___. Sie bekommen sie ohne Rezept. (প্রেসক্রিপশন ছাড়া)","options":["allergisch","rezeptfrei","ansteckend"],"answer":1,"id":"b1-practice-39-q3"},{"type":"mcq","prompt":"Ich bin ___ gegen Milch. (অ্যালার্জিক)","options":["nervös","munter","allergisch"],"answer":2,"id":"b1-practice-39-q4"},{"type":"mcq","prompt":"„schwindelig“ মানে কী?","options":["মাথা ঘোরা","ক্ষুধার্ত","কঠোর"],"answer":0,"id":"b1-practice-39-q5"},{"type":"mcq","prompt":"Du siehst so ___ aus. Bist du krank? (ফ্যাকাশে)","options":["schlank","blass","munter"],"answer":1,"id":"b1-practice-39-q6"},{"type":"mcq","prompt":"„regelmäßig“ মানে কী?","options":["অবিরাম","স্থায়ী","নিয়মিত"],"answer":2,"id":"b1-practice-39-q7"},{"type":"mcq","prompt":"„körperlich“ মানে কী?","options":["শারীরিক","মানসিক","ব্যক্তিগত"],"answer":0,"id":"b1-practice-39-q8"},{"type":"mcq","prompt":"Ich trinke weder Wein ___ Saft.","options":["als auch","noch","oder"],"answer":1,"id":"b1-practice-39-q9"},{"type":"mcq","prompt":"Sowohl Obst ___ Gemüse sind gesund.","options":["noch","oder","als auch"],"answer":2,"id":"b1-practice-39-q10"},{"type":"mcq","prompt":"Bitte ___ Sie tief ein. (শ্বাস নেওয়া)","options":["atmen","nehmen","ziehen"],"answer":0,"explanation":"einatmen: atmen … ein।","id":"b1-practice-39-q11"},{"type":"mcq","prompt":"Ich ___ die Tabletten morgens ein.","options":["schlucke","nehme","atme"],"answer":1,"explanation":"einnehmen: nehme … ein।","id":"b1-practice-39-q12"},{"type":"mcq","prompt":"„verzichten auf“ মানে কী?","options":["অপেক্ষা করা","আশা করা","ত্যাগ করা"],"answer":2,"id":"b1-practice-39-q13"},{"type":"mcq","prompt":"Der Patient, ___ gestern entlassen wurde, ist wieder zu Hause.","options":["der","den","dem"],"answer":0,"explanation":"Relativsatz + Passiv: der Patient → der।","id":"b1-practice-39-q14"},{"type":"mcq","prompt":"Wenn ich nicht erkältet ___, würde ich mitkommen.","options":["war","wäre","bin"],"answer":1,"id":"b1-practice-39-q15"}],"requires":{"grammar":23,"vocabulary":25}},"schema":1,"id":"b1-practice-39","level":"B1","test":[]}