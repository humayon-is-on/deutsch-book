{"module":"practice","item":{"id":"b1-practice-2","level":"B1","kind":"fill","title":{"de":"Rund ums Wohnen 1","bn":"বাসস্থান ১"},"questions":[{"type":"gap","prompt":"Meine Wohnung ist in einem ___. (পুরনো ভবন)","answers":["Altbau"],"options":["Altbau","Neubau","Dachboden"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q1"},{"type":"gap","prompt":"Der ___ zeigt uns die Wohnung. (দালাল)","answers":["Makler"],"options":["Makler","Behälter","Speicher"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q2"},{"type":"gap","prompt":"Meine Kleidung ist im ___. (পোশাকের আলমারি)","answers":["Kleiderschrank"],"options":["Kleiderschrank","Messbecher","Kellereingang"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q3"},{"type":"gap","prompt":"Wir sitzen abends auf der ___. (সোফা)","answers":["Couch"],"options":["Couch","Wiese","Fläche"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q4"},{"type":"gap","prompt":"Im Sommer frühstücken wir auf der ___. (বারান্দা)","answers":["Terrasse"],"options":["Terrasse","Grundmiete","Anlage"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q5"},{"type":"gap","prompt":"Die ___ kostet 500 Euro im Monat. (মূল ভাড়া)","answers":["Grundmiete"],"options":["Grundmiete","Wohnküche","Rücksicht"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q6"},{"type":"gap","prompt":"Ohne ___ funktioniert der Kühlschrank nicht. (বিদ্যুৎ)","answers":["Strom"],"options":["Strom","Brand","Gang"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q7"},{"type":"gap","prompt":"Die Kinder spielen auf der ___. (তৃণভূমি)","answers":["Wiese"],"options":["Wiese","Terrasse","Couch"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q8"},{"type":"gap","prompt":"Obwohl die Wohnung klein ___, ist sie teuer.","answers":["ist"],"options":["ist","sind","bin"],"promptBn":"obwohl-এর অংশে verb শেষে","id":"b1-practice-2-q9"},{"type":"gap","prompt":"___ ich müde bin, koche ich heute. (যদিও)","answers":["Obwohl"],"options":["Obwohl","Weil","Trotzdem"],"promptBn":"যদিও","id":"b1-practice-2-q10"},{"type":"gap","prompt":"Ich nehme die Wohnung, obwohl sie keinen Balkon ___.","answers":["hat"],"options":["hat","haben","habe"],"promptBn":"obwohl-এর অংশে verb শেষে","id":"b1-practice-2-q11"},{"type":"gap","prompt":"Die Wohnung ist alt. ___ gefällt sie mir. (তবুও)","answers":["Trotzdem"],"options":["Trotzdem","Obwohl","Weil"],"promptBn":"তবুও","id":"b1-practice-2-q12"},{"type":"gap","prompt":"Ich suche eine Wohnung, ___ ich in Berlin arbeite. (কারণ)","answers":["weil"],"options":["weil","obwohl","trotzdem"],"promptBn":"কারণ","id":"b1-practice-2-q13"},{"type":"gap","prompt":"Gestern ___ ich keine Zeit. (haben, অতীত)","answers":["hatte"],"options":["hatte","habe","hat"],"promptBn":"A2: haben-এর অতীত","id":"b1-practice-2-q14"},{"type":"gap","prompt":"Ich wohne seit drei Jahren ___ Berlin.","answers":["in"],"options":["in","nach","zu"],"promptBn":"A1 মনে করুন: শহরের নামের আগে","id":"b1-practice-2-q15"},{"type":"gap","prompt":"Unser Haus hat einen großen ___. Dort liegen alte Bücher. (চিলাকোঠা)","answers":["Dachboden"],"options":["Dachboden","Messbecher","Kellereingang"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q16"},{"type":"gap","prompt":"Für den Kuchen brauche ich einen ___. (মাপার কাপ)","answers":["Messbecher"],"options":["Messbecher","Behälter","Durchschnitt"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q17"},{"type":"gap","prompt":"Obwohl der Gang sehr lang ___, ist die Wohnung klein.","answers":["ist"],"options":["ist","sind","hat"],"promptBn":"obwohl-অংশে verb শেষে","id":"b1-practice-2-q18"},{"type":"gap","prompt":"Obwohl der Altbau schon alt ___, ist er in einem guten ___. (অবস্থা)","answers":["ist","Zustand"],"options":["ist","Zustand","sind","Zeitpunkt"],"promptBn":"দুটি ফাঁক পূরণ করুন","explanation":"obwohl-অংশে verb শেষে; Zustand = অবস্থা।","id":"b1-practice-2-q19"},{"type":"gap","prompt":"Lisa schreibt: „Unsere Wohnung ist nicht groß, aber wir haben eine schöne Terrasse und hinter dem Haus eine ___. Dort spielen die Kinder jeden Tag.“ (তৃণভূমি)","answers":["Wiese"],"options":["Wiese","Fläche","Couch"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-2-q20"}],"requires":{"grammar":1,"vocabulary":1}},"schema":1,"id":"b1-practice-2","level":"B1","test":[]}