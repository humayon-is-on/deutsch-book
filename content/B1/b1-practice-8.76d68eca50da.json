{"module":"practice","item":{"id":"b1-practice-8","level":"B1","kind":"fill","title":{"de":"seitdem · Einkaufen 1","bn":"যখন থেকে · কেনাকাটা ১"},"questions":[{"type":"gap","prompt":"___ ich in Dhaka wohne, fahre ich oft mit dem Bus. (যখন থেকে)","answers":["Seitdem"],"options":["Seitdem","Nachdem","Bevor"],"promptBn":"যখন থেকে","id":"b1-practice-8-q1"},{"type":"gap","prompt":"Seitdem ich Sport ___, schlafe ich besser. (machen)","answers":["mache"],"options":["mache","macht","machen"],"promptBn":"seitdem-এর অংশে verb শেষে","id":"b1-practice-8-q2"},{"type":"gap","prompt":"Er ist glücklich, seitdem er eine neue Arbeit ___.","answers":["hat"],"options":["hat","haben","habe"],"promptBn":"seitdem-এর অংশে verb শেষে","id":"b1-practice-8-q3"},{"type":"gap","prompt":"Seitdem ich Deutsch lerne, ___ ich deutsche Filme. (sehen)","answers":["sehe"],"options":["sehe","siehst","sehen"],"promptBn":"কমার পরেই মূল verb","id":"b1-practice-8-q4"},{"type":"gap","prompt":"Ich habe die ___ noch. Kann ich die Hose umtauschen? (রশিদ)","answers":["Quittung"],"options":["Quittung","Garantie","Ware"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-8-q5"},{"type":"gap","prompt":"Auf das Handy gibt es zwei Jahre ___. (গ্যারান্টি)","answers":["Garantie"],"options":["Garantie","Quittung","Rabatt"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-8-q6"},{"type":"gap","prompt":"Heute gibt es 20 Euro ___. (ছাড়)","answers":["Rabatt"],"options":["Rabatt","Handel","Mangel"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-8-q7"},{"type":"gap","prompt":"Die Hose probiere ich in der ___ an. (পোশাক পরিবর্তনের কক্ষ)","answers":["Umkleidekabine"],"options":["Umkleidekabine","Drogerie","Bäckerei"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-8-q8"},{"type":"gap","prompt":"Brot kaufe ich in der ___. (বেকারি)","answers":["Bäckerei"],"options":["Bäckerei","Metzgerei","Drogerie"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-8-q9"},{"type":"gap","prompt":"Fleisch kaufe ich in der ___. (মাংসের দোকান)","answers":["Metzgerei"],"options":["Metzgerei","Bäckerei","Umkleidekabine"],"promptBn":"বন্ধনীর অর্থ দেখে বেছে নিন","id":"b1-practice-8-q10"},{"type":"gap","prompt":"Nachdem ich ___ habe, gehe ich einkaufen. (frühstücken)","answers":["gefrühstückt"],"options":["gefrühstückt","frühstücke","gefrühstücken"],"promptBn":"nachdem + Perfekt","id":"b1-practice-8-q11"},{"type":"gap","prompt":"Die Wohnung ist klein, aber sehr ___. (আরামদায়ক)","answers":["gemütlich"],"options":["gemütlich","eng","gering"],"promptBn":"বিশেষণ","id":"b1-practice-8-q12"},{"type":"gap","prompt":"Bevor ich ___, schalte ich das Licht aus. (gehen)","answers":["gehe"],"options":["gehe","gehst","gehen"],"promptBn":"bevor-এর অংশে verb শেষে","id":"b1-practice-8-q13"},{"type":"gap","prompt":"Ich habe ___ Mutter ein Geschenk gekauft.","answers":["meiner"],"options":["meiner","meine","meinen"],"promptBn":"A2: Dativ, die Mutter → meiner","id":"b1-practice-8-q14"},{"type":"gap","prompt":"Ich ___ gestern im Supermarkt. (sein, অতীত)","answers":["war"],"options":["war","bin","wäre"],"promptBn":"A2: sein-এর অতীত","id":"b1-practice-8-q15"}],"requires":{"grammar":5,"vocabulary":5}},"schema":1,"id":"b1-practice-8","level":"B1","test":[]}