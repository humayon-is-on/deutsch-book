{"module":"practice","item":{"id":"b1-practice-28","level":"B1","kind":"fill","title":{"de":"statt … zu · Umwelt 5","bn":"বদলে · পরিবেশ ৫"},"questions":[{"type":"gap","prompt":"___ fernzusehen, lerne ich Deutsch. (বদলে)","answers":["Statt"],"options":["Statt","Ohne","Um"],"promptBn":"বদলে","id":"b1-practice-28-q1"},{"type":"gap","prompt":"Statt mit dem Auto zu ___, nehme ich das Fahrrad.","answers":["fahren"],"options":["fahren","fährt","gefahren"],"promptBn":"statt … zu + infinitive","id":"b1-practice-28-q2"},{"type":"gap","prompt":"Er spielt am Handy, statt seine Hausaufgaben zu ___.","answers":["machen"],"options":["machen","macht","gemacht"],"promptBn":"statt … zu + infinitive","id":"b1-practice-28-q3"},{"type":"gap","prompt":"Anstatt Wasser zu ___, trinkt er Saft. (trinken)","answers":["trinken"],"options":["trinken","trinkt","getrunken"],"promptBn":"anstatt … zu + infinitive","id":"b1-practice-28-q4"},{"type":"gap","prompt":"Bitte ___ Sie das Licht aus. (বন্ধ করা)","answers":["schalten"],"options":["schalten","schaltet","schalte"],"promptBn":"ausschalten: schalten … aus","id":"b1-practice-28-q5"},{"type":"gap","prompt":"Autos ___ die Luft. (দূষিত করা)","answers":["verschmutzen"],"options":["verschmutzen","verschmutzt","verschmutze"],"promptBn":"Autos → বহুবচন","id":"b1-practice-28-q6"},{"type":"gap","prompt":"Ein Fahrrad ___ sich in der Stadt. (লাভজনক হওয়া)","answers":["lohnt"],"options":["lohnt","lohnen","lohne"],"promptBn":"sich lohnen: es → lohnt","id":"b1-practice-28-q7"},{"type":"gap","prompt":"Wir müssen die Natur ___. (রক্ষা করা)","answers":["schützen"],"options":["schützen","schützt","verursachen"],"promptBn":"müssen + infinitive","id":"b1-practice-28-q8"},{"type":"gap","prompt":"Er ging, ohne die Tür ___ schließen.","answers":["zu"],"options":["zu","um","statt"],"promptBn":"ohne … zu","id":"b1-practice-28-q9"},{"type":"gap","prompt":"Ich kaufe regional, ___ die Umwelt zu schützen.","answers":["um"],"options":["um","ohne","statt"],"promptBn":"উদ্দেশ্য