{"module":"practice","item":{"id":"b1-practice-46","level":"B1","kind":"fill","title":{"de":"so … dass","bn":"এতটাই … যে"},"questions":[{"type":"gap","prompt":"Ich bin so müde, ___ ich nicht lernen kann.","answers":["dass"],"options":["dass","ob","damit"],"promptBn":"so … dass","id":"b1-practice-46-q1"},{"type":"gap","prompt":"Ich bin ___ müde, dass ich nicht lernen kann. (এতটাই)","answers":["so"],"options":["so","zu","sehr"],"promptBn":"so … dass","id":"b1-practice-46-q2"},{"type":"gap","prompt":"Das Essen war so scharf, dass ich viel Wasser trinken ___.","answers":["musste"],"options":["musste","muss","müssen"],"promptBn":"dass-এর অংশে verb শেষে","id":"b1-practice-46-q3"},{"type":"gap","prompt":"Es regnet so stark, dass wir zu Hause ___.","answers":["bleiben"],"options":["bleiben","bleibt","zu bleiben"],"promptBn":"dass-এর অংশে verb শেষে","id":"b1-practice-46-q4"},{"type":"gap","prompt":"Der Film war so langweilig, dass ich ___ bin. (einschlafen, Perfekt)","answers":["eingeschlafen"],"options":["eingeschlafen","einschlafen","geschlafen ein"],"promptBn":"Partizip II","id":"b1-practice-46-q5"},{"type":"gap","prompt":"Die Arbeit ist so anstrengend, dass ich abends sofort ___. (einschlafen)","answers":["einschlafe"],"options":["einschlafe","schlafe ein","einschlafen"],"promptBn":"dass-এর অংশে verb শেষে, একসঙ্গে লেখা","id":"b1-practice-46-q6"},{"type":"gap","prompt":"Er spricht so schnell, dass ich ihn nicht ___.","answers":["verstehe"],"options":["verstehe","versteht","verstehen"],"promptBn":"dass-এর অংশে verb শেষে","id":"b1-practice-46-q7"},{"type":"gap","prompt":"Die Wohnung war so teuer, dass wir sie nicht ___ haben.","answers":["genommen"],"options":["genommen","nehmen","genehmt"],"promptBn":"Perfekt: haben … genommen","id":"b1-practice-46-q8"},{"type":"gap","prompt":"Die Wohnung ist ___ klein, aber sehr gemütlich.","answers":["zwar"],"options":["zwar","so","je"],"promptBn":"zwar … aber","id":"b1-practice-46-q9"},{"type":"gap","prompt":"Je mehr Sport ich mache, ___ besser schlafe ich.","answers":["desto"],"options":["desto","so","dass"],"promptBn":"je … desto","id":"b1-practice-46-q10"},{"type":"gap","prompt":"Sie will nach dem Studium eine Firma ___. (প্রতিষ্ঠা করা)","answers":["gründen"],"options":["gründen","entlassen","beibringen"],"promptBn":"will + infinitive","id":"b1-practice-46-q11"},{"type":"gap","prompt":"Meine Mutter hat mir das Nähen ___. (শেখানো)","answers":["beigebracht"],"options":["beigebracht","gegründet","beeindruckt"],"promptBn":"Partizip II","id":"b1-practice-46-q12"},{"type":"gap","prompt":"Nach fünf Jahren ist er nach Bangladesch ___. (ফিরে আসা)","answers":["zurückgekehrt"],"options":["zurückgekehrt","zurückgekehren","zurückkehrt"],"promptBn":"Partizip II, sein-এর সঙ্গে","id":"b1-practice-46-q13"},{"type":"gap","prompt":"Ich habe mich ___ eine Stelle als Ingenieur beworben.","answers":["um"],"options":["um","für","auf"],"promptBn":"sich bewerben um","id":"b1-practice-46-q14"},{"type":"gap","prompt":"Entweder du kommst mit ___ du bleibst zu Hause.","answers":["oder"],"options":["oder","noch","aber"],"promptBn":"entweder … oder","id":"b1-practice-46-q15"}],"requires":{"grammar":28,"vocabulary":29}},"schema":1,"id":"b1-practice-46","level":"B1","test":[]}